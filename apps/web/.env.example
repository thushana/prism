# App environment (apps/web)
#
# Local setup: values are copied to `.env` on `prism generate` — edit `.env` before db:push.
# Never commit `.env`. Next.js loads `.env` from this directory when you run from apps/web or via root scripts.

# =============================================================================
# Database - Neon PostgreSQL
# =============================================================================

# https://console.neon.tech
# Pooled URL — runtime queries
DATABASE_URL=postgresql://user:password@ep-xxxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Direct URL — drizzle-kit (migrations, push)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require

# =============================================================================
# Google Maps API (optional)
# =============================================================================

# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional browser key for PrismMap (falls back to GOOGLE_MAPS_API_KEY)
# GOOGLE_MAPS_WEB_KEY=your_browser_restricted_key_here

# =============================================================================
# Mapbox (optional)
# =============================================================================

# https://account.mapbox.com/ — publishable token (pk.*) only if exposed to the browser
# MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# =============================================================================
# Better Auth (Prism default)
# =============================================================================

# openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# First admin user (pnpm run db:seed:admin)
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=your_secure_password

# =============================================================================
# Cron / hosting (optional)
# =============================================================================

CRON_SECRET=your_cron_secret_here
HOST_PROJECT_DASHBOARD=https://vercel.com/username/project

# Feature Flags (Vercel Flags Explorer)
# FLAGS_SECRET=your_base64_secret_here

NODE_ENV=development
