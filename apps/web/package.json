{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx ../../scripts/run-next-dev.ts --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint app",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"*.{ts,tsx}\" \"*.{js,mjs}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=database/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=database/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=database/drizzle.config.ts",
    "db:seed": "tsx database/seed.ts",
    "db:seed:admin": "tsx database/seed-admin.ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prism/utilities": "workspace:*",
    "@radix-ui/react-slot": "^1.3.3",
    "admin": "workspace:*",
    "application-settings": "workspace:*",
    "authentication": "workspace:*",
    "better-auth": "1.6.30",
    "database": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "feature-flags": "workspace:*",
    "flags": "^4.3.0",
    "intelligence": "workspace:*",
    "logger": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ui": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "commander": "^15.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.4",
    "lightningcss": "^1.33.0",
    "postcss-import": "^16.1.1",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
