{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx ../../scripts/run-next-dev.ts",
    "assert:required-env": "tsx ../../scripts/assert-required-env.ts",
    "build": "pnpm run assert:required-env && next build",
    "start": "next start",
    "lint": "eslint app",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"*.{ts,tsx}\" \"*.{js,mjs}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=database/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=database/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=database/drizzle.config.ts",
    "db:seed": "tsx database/seed.ts",
    "db:seed:admin": "tsx database/seed-admin.ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prism/utilities": "workspace:*",
    "@radix-ui/react-slot": "^1.3.3",
    "admin": "workspace:*",
    "application-settings": "workspace:*",
    "authentication": "workspace:*",
    "better-auth": "1.7.25",
    "database": "workspace:*",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.3",
    "feature-flags": "workspace:*",
    "flags": "^4.3.1",
    "intelligence": "workspace:*",
    "logger": "workspace:*",
    "mapbox-gl": "^3.35.0",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "ui": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "commander": "^15.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "lightningcss": "^1.33.0",
    "postcss-import": "^17.0.0",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
